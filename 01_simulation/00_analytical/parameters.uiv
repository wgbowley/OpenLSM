[version]
format:     0.1.1
unit_frame: derived.ut

[notes]
simulation: "Analytical Model"
system:     "Axisymmetric (Z-R) (Axial-Radial)"

# ---------------------------------------------
[numerics]
line_voltage: 12 (V)
displacement: 400 m(m)

[numerics.samples]
displacement_size:  1 m(m)

[numerics.solver]
integration_step:   0.2 m(m)
derivative_step:    0.2 m(m)

[numerics.output]
interval: 30 (∅)

# ---------------------------------------------

[armature]
number_slots:       6 (∅)
radial_clearance:   1 m(m)

[armature.core]
radial_wall_thickness: 1 m(m)

[armature.slots]
axial_pitch:    6.666 m(m)
axial_length:   6 m(m)

radial_thickness: 5 m(m)

[armature.slots.material]
wire_diameter:  0.33 m(m)
fill_factor:    0.70 (∅)

conductivity:   63 M(S_m)

# ---------------------------------------------

[stator]
length: 300 m(m)

[stator.tube]
radial_wall_thickness:  1 m(m)

[stator.dipole]
axial_length: 20 m(m)
radial_thickness: 6 m(m)

[stator.dipole.material]
coercivity: 0.956 M(A_m)

# ---------------------------------------------
