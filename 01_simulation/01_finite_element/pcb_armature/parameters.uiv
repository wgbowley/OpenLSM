[version]
format: 0.1.0


[notes]
type: "Electromagnetic Parameter File"
application: "Finite Element Model | Tubular Ironless PCB Armature Linear Motor"
coordinate_system: "axisymmetric (Z-R) (Axial-Radial)"


[model]
environmental_temperature: 293.15 (K)
environmental_material: "air"
