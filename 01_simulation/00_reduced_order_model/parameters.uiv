[version]
format: 0.1.0
unit_frame: metric.ut


[notes]
type: "Electromagnetic Parameter File"
application: "Reduced Order Model | Tubular Ironless Linear Motor"
coordinate_system: "Axial-symmetric (Z-R) (Axial-Radial)"


[numerics]
displacement_steps:     300
integration_step_size:  1 m(m)

line_voltage:   12 (V)
temperature:    300 (K)

[armature.core]
number_slots: 9
axial_slot_pitch: 6.667 m(m)

radial_clearance: 1 m(m)
radial_thickness: 0 m(m)

[armature.slots]
# Material: copper
wire_diameter: 0.4 m(m)
fill_factor: 0.65

axial_length: 6 m(m)
radial_thickness: 5 m(m)

[stator.tube]
length: 300 m(m)
radial_thickness: 1 m(m)

[stator.poles]
# Material: N52 -> NdFeB
radial_thickness: 5 m(m)
axial_length: 20 m(m)