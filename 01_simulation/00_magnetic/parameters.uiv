[version]
format:     0.1.2
unit_frame: derived.ut

# ---------------------------------------------

[notes]
simulation: "Reduced Order Analytical Model"
system:     "Axisymmetric (Z-R) (Axial-Radial)"

# ---------------------------------------------

[numerics]
velocity:     650 m(m/s)
line_voltage: 6 (V)
displacement: 300 m(m)

[numerics.samples]
displacement_size:  1 m(m)

[numerics.solver]
integration_step:   0.2 m(m)
derivative_step:    0.2 m(m)

[numerics.output]
interval: 20 (∅)

# ---------------------------------------------

[armature]
number_slots:       18 (∅)
radial_clearance:   0.5 m(m)

[armature.core]
radial_wall_thickness: 0 m(m)

[armature.slots]
axial_pitch:    3.333 m(m)
axial_length:   3.30 m(m)

radial_thickness: 4.8 m(m)

[armature.slots.material]
wire_diameter:  0.30 m(m)
fill_factor:    0.8 (∅)

conductivity:   58 M(S_m)

# ---------------------------------------------

[stator]
length: 300 m(m)

[stator.tube]
radial_wall_thickness:  1 m(m)

[stator.dipole]
axial_length: 10 m(m)
radial_thickness: 5 m(m)

[stator.dipole.material]
# Axially Magnetized
coercivity: 0.956 M(A_m)

# ---------------------------------------------