[version]
format: 0.1.0
unit_frame: metric.ut


[notes]
type: "Electromagnetic Parameter File"
application: "Reduced Order Model | Tubular Ironless Linear Motor"
coordinate_system: "Axial-symmetric (Z-R) (Axial-Radial)"


[numerics]
time_step:      100 u(s)
line_voltage:   24 (V)
temperature:    300 (K)

# Verbose output frequency
msg_freq:  25  (s^-1)


[armature.core]
number_slots: 12 (∅)
axial_slot_pitch: 6.833 m(m)

radial_clearance: 1 m(m)
radial_thickness: 1 m(m)

[armature.slots]
# Material: copper
wire_diameter: 0.3 m(m)
fill_factor: 0.65

axial_length: 4.83 m(m)
radial_thickness: 3.00 m(m)


[stator.tube]
radial_thickness: 1 m(m)

[stator.poles]
# Material: N52 -> NdFeB
radial_thickness: 5 m(m)
axial_length: 20 m(m)