# .pylintrc
# Note: these descriptions are generated by an LLM. Refer to the .pylint documentation
# if specifics of a single error code are important.

[MESSAGES CONTROL]
disable = W0621,                      # redefined-outer-name - Redefining name from outer scope (shadowing)
          W0105,                      # pointless-string-statement - String statement has no effect
          C0321,                      # multiple-statements - Multiple statements on one line
          R0913,                      # too-many-arguments - Too many arguments (>5) in function/method
          R0902,                      # too-many-instance-attributes - Too many instance attributes (>7)
          R0903,                      # too-few-public-methods - Too few public methods (<2)
          E0401,                      # import-error - Unable to import module
          R0917,                      # too-many-positional-arguments - Too many positional arguments (>5)
          C0103                       # invalid-name - Doesn't conform to snake_case naming

[FORMAT]
max-line-length = 120                 # Maximum number of characters on a single line