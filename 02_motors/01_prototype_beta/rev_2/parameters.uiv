[version]
format:     0.1.0
unit_frame: si_metric.ut


[notes]
parameters: "prototype_beta/rev_2 design"
system:     "Axisymmetric (Z-R) (Axial-Radial)"

# ---------------------------------------------

[model]
environmental_material: "air"

# pole pair = 2 poles per pair
pole_pairs:     4 (∅)
number_slots:   12 (∅)

# ---------------------------------------------

[armature.core]
material:           "Carbon Fibre Nylon"

# Axial Parameters
axial_end_caps:     5.00 m(m)
axial_slot_pitch:   6.833 m(m)

# Radial parameters
radial_clearance:   1 m(m)
radial_thickness:   1 m(m)

[armature.slots]
material:           "copper"
wire_diameter:      0.4 m(m)
fill_factor:        0.65

axial_length:       4.83 m(m)
radial_thickness:   3.00 m(m)

[armature.heat_sink]
material:               "aluminum"
alloy:                  6061

# No specific material hence the generic name
interface_material:     "thermal_paste"

# Axial Parameters
axial_fin_length:       0.50 m(m)
axial_fin_pitch:        1.50 m(m)

# Radial parameters
radial_clearance:       1 m(m)
radial_inner_thickness: 1.8 m(m)
radial_fin_thickness:   7.30 m(m)

# ---------------------------------------------

[stator.tube]
material:           "Layered Carbon Fibre Epoxy"
radial_thickness:   1 m(m)

[stator.poles]
material:           "NdFeB"
grade:              "N52"

radial_thickness:   5 m(m)
axial_length:       20 m(m)

# ---------------------------------------------